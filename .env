# Postgres
POSTGRES_DB=BotDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_EXPOSE_PORTS=5432
POSTGRES_PORTS=5432:5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORTS=5050:80

# Сеть
SUBNET=10.5.0.0/16
POSTGRES_PORTS=5432:5432
POSTGRES_EXPOSE_PORTS=5432

# Приложение
HTTP_PORTS=8090:8080
HTTPS_PORTS=8091:8081
BotToken=your_token
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

EnableDomainWhitelist=false
EnableExistUserCheck=false